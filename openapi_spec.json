{
  "openapi": "3.1.0",
  "info": {
    "title": "CRISPR Base Editor Window API",
    "description": "Research-use API for fixed, heuristic CBE/ABE activity-window scoring and same-locus bystander identification. Scores are not assay-calibrated probabilities.",
    "version": "2.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and supported editors",
        "responses": {
          "200": {"description": "Service metadata"}
        }
      }
    },
    "/api/profiles": {
      "get": {
        "summary": "Return fixed relative-activity profiles",
        "responses": {
          "200": {"description": "Heuristic editor profiles"}
        }
      }
    },
    "/api/analyze": {
      "post": {
        "summary": "Analyze a 20-nt protospacer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["spacer"],
                "properties": {
                  "spacer": {"type": "string", "minLength": 20, "maxLength": 20},
                  "pam": {"type": "string", "default": "NGG", "minLength": 3, "maxLength": 3},
                  "editor": {"type": "string", "default": "BE4MAX", "enum": ["BE4MAX", "BE3", "TARGET_AID", "ABE7.10", "ABE8E"]},
                  "intended_position": {"type": ["integer", "null"], "minimum": 1, "maximum": 20},
                  "base_efficiency_scaling": {"type": "number", "minimum": 0, "maximum": 100, "default": 65.0}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Base-editor window analysis"},
          "422": {"description": "Invalid input"}
        }
      }
    }
  }
}
